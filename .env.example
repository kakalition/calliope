# --- Identity ---------------------------------------------------------------
AGENT_NAME=calliope
OWNER_ID=owner
OWNER_NAME=Writer
AGENT_HOME=~/.local/share/calliope
LOG_LEVEL=INFO
LOG_JSON=false

# --- Model / provider (any OpenAI-compatible endpoint) ----------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=openai:gpt-4o-mini
MODEL_TIMEOUT=60
MODEL_RETRIES=2

# --- Observability (on by default, self-hosted, no account) -----------------
#   phoenix | console | otlp | off
OBSERVABILITY=phoenix
OTLP_ENDPOINT=

# --- Journaling / ESL -------------------------------------------------------
# CEFR level used when the writer does not specify one.
DEFAULT_ESL_LEVEL=B1
# Soft daily writing goal (words) used for progress nudges.
DAILY_WORD_GOAL=150

# --- Telegram (optional) ----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# --- A2A / MCP servers ------------------------------------------------------
A2A_PUBLIC_URL=http://127.0.0.1:9100
A2A_HOST=127.0.0.1
A2A_PORT=9100
MCP_HOST=127.0.0.1
MCP_PORT=8860
PEERS_FILE=
